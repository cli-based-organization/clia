#!/usr/bin/env bash
# bin/clia — le CLI du système d'information clia.
#
# Ce fichier ne porte aucune commande : il les trouve. Chaque commande est un
# fichier lib/clia/cmd/<nom>.sh portant deux lignes de déclaration :
#
#   # Description: ce que la commande fait, en une ligne
#   # Périmètre: dépôt | aucun
#
# Déposer un fichier là suffit à l'exposer dans l'aide et à le rendre
# invocable. Le mécanisme est emprunté à _scripts/clia du dépôt
# noumanity-wiki ; le champ Périmètre lui est ajouté, parce que clia — à la
# différence de ce dépôt-là — travaille sur un dépôt qui n'est pas le sien.
#
#   Périmètre: dépôt   la commande agit sur le dépôt git courant. Le
#                      dispatcher le résout, applique la garde du mode
#                      --activate, et le passe dans CLIA_WORK_DIR.
#   Périmètre: aucun   la commande n'agit sur aucun dépôt (setup).
#
# Sans déclaration, le périmètre vaut « dépôt » : oublier la ligne restreint,
# et ne dispense jamais de la garde.

set -euo pipefail

_CLIA_NOM='clia'

# --------------------------------------------------------------------------
# Amorçage
# --------------------------------------------------------------------------
#
# En mode --dev, ce fichier est atteint par un lien symbolique depuis le
# répertoire des exécutables de l'utilisateur. Ses modules sont dans le dépôt
# source, pas à côté du lien : il faut donc résoudre les liens avant de
# chercher lib/. La même résolution existe dans lib/clia/commun.sh, mais
# elle ne peut pas servir ici — c'est elle qu'il s'agit d'aller chercher.

_clia_amorcer() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  printf '%s\n' "${dir%/bin}"
}

CLIA_SOURCE_DIR=$(_clia_amorcer)
# Le chemin par lequel la commande a été appelée : un lien en mode --dev, le
# fichier lui-même sinon. Les modules le rapportent à l'humain, et ne
# pourraient pas le retrouver seuls une fois lancés par le dispatcher.
CLIA_EXECUTABLE="${BASH_SOURCE[0]}"
export CLIA_SOURCE_DIR CLIA_EXECUTABLE

if [[ ! -f "$CLIA_SOURCE_DIR/lib/clia/commun.sh" ]]; then
  printf 'clia: lib/clia/commun.sh est introuvable sous %s\n' "$CLIA_SOURCE_DIR" >&2
  printf '      le dépôt source a-t-il été déplacé ? relancez : . setup.sh install --dev --force\n' >&2
  exit 1
fi

# shellcheck source=../lib/clia/commun.sh
. "$CLIA_SOURCE_DIR/lib/clia/commun.sh"

CMD_DIR="$CLIA_SOURCE_DIR/lib/clia/cmd"

# --------------------------------------------------------------------------
# Les déclarations d'une commande
# --------------------------------------------------------------------------

_clia_description_de() {
  grep -m1 -E '^#[[:space:]]*Description:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Description:[[:space:]]*//' || true
}

_clia_perimetre_de() {
  local declaration
  declaration=$(grep -m1 -E '^#[[:space:]]*Périmètre:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Périmètre:[[:space:]]*//' || true)
  printf '%s\n' "${declaration:-dépôt}"
}

# --------------------------------------------------------------------------
# Aide
# --------------------------------------------------------------------------

_clia_aide() {
  cat <<EOF
clia $_CLIA_VERSION — système d'information collaboratif entre humains,
automatismes et intelligences artificielles.

Usage : clia <commande> [arguments]

Commandes :
EOF
  local f nom desc
  for f in "$CMD_DIR"/*.sh; do
    [[ -f "$f" ]] || continue
    nom=$(basename "$f" .sh)
    desc=$(_clia_description_de "$f")
    printf '  %-12s %s\n' "$nom" "${desc:-(sans description)}"
  done
  cat <<'EOF'

Options :
  -h, --help        cette aide
  -v, --version     la version

Aide d'une commande :
  clia <commande> --help

Installer clia se fait depuis son dépôt source :
  . setup.sh install --activate    ce shell, et le dépôt source seulement
  . setup.sh install --dev         toute session, et tout dépôt git

Codes de retour :
  0  la demande est satisfaite
  1  refus : hors périmètre, ou rien à faire
  2  demande mal formée
EOF
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

case "${1:-}" in
  ''|-h|--help|help) _clia_aide; exit 0 ;;
  -v|--version)      printf '%s\n' "$_CLIA_VERSION"; exit 0 ;;
esac

COMMANDE="$1"
shift

# Le nom sert à construire un chemin : il est restreint pour qu'il ne puisse
# pas sortir de cmd/ — ni « / », ni « .. ».
if [[ ! "$COMMANDE" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  _clia_msg "nom de commande invalide : $COMMANDE"
  exit 2
fi

FICHIER="$CMD_DIR/${COMMANDE}.sh"
if [[ ! -f "$FICHIER" ]]; then
  _clia_msg "commande inconnue : $COMMANDE"
  _clia_detail "l'aide, et la liste des commandes : clia --help"
  exit 2
fi

# La garde du mode --activate s'applique ici, une fois, plutôt que dans
# chaque commande : une commande nouvelle en hérite sans rien déclarer.
if [[ "$(_clia_perimetre_de "$FICHIER")" == 'dépôt' ]]; then
  CLIA_WORK_DIR=$(_clia_depot_de_travail) || exit 1
  export CLIA_WORK_DIR
fi

exec bash "$FICHIER" "$@"

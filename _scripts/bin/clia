#!/usr/bin/env bash
# _scripts/bin/clia — le CLI du système d'information clia.
#
# Ce fichier ne porte aucune commande : il les trouve. Une commande est un
# fichier <nom>.sh déposé sous _scripts/lib/cmd/, sous les _scripts/ d'une
# ressource, ou sous ceux d'une ressource qu'une extension apporte, portant
# ses déclarations en tête :
#
#   # Description: ce que la commande fait, en une ligne
#   # Périmètre:   dépôt | aucun
#   # Signature:   une forme d'invocation valide       (répétable)
#   # Option:      <chemin> <option>                   (répétable)
#
# Déposer un fichier suffit à l'exposer dans l'aide et à le rendre invocable.
# Les deux dernières déclarations sont ce dont l'aide brève est faite : une
# commande ne rédige pas son aide, elle déclare ses formes valides.
#
# Pourquoi une découverte plutôt qu'une liste écrite. C'est le seul mécanisme
# que toutes les générations précédentes ont porté sans qu'aucune ne le
# conteste, et le seul qui rende l'extensibilité mécanique plutôt que
# déclarative : ajouter une commande ne demande pas de modifier ce fichier.
# La génération 4 en avait fait le constat après l'avoir éprouvé ; celle-ci
# part de là.
#
#   Périmètre: dépôt   la commande agit sur un dépôt git. Le point d'entrée
#                      le résout et le passe dans CLIA_WORK_DIR.
#   Périmètre: aucun   la commande n'a besoin d'aucun dépôt.
#
# Sans déclaration, le périmètre vaut « dépôt » : oublier la ligne restreint,
# et n'ouvre jamais.

set -euo pipefail

_CLIA_NOM='clia'

# --------------------------------------------------------------------------
# Amorçage
# --------------------------------------------------------------------------
#
# Ce fichier peut être atteint par un lien symbolique. Ses modules sont dans
# le dépôt source, pas à côté du lien : les liens sont donc suivis jusqu'au
# bout avant de chercher _scripts/lib.

_clia_amorcer() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  printf '%s\n' "${dir%/_scripts/bin}"
}

CLIA_SOURCE_DIR=$(_clia_amorcer)
CLIA_EXECUTABLE="${BASH_SOURCE[0]}"
export CLIA_SOURCE_DIR CLIA_EXECUTABLE

if [[ ! -f "$CLIA_SOURCE_DIR/_scripts/lib/commun.sh" ]]; then
  printf 'clia: _scripts/lib/commun.sh est introuvable sous %s\n' "$CLIA_SOURCE_DIR" >&2
  printf '      le dépôt source a-t-il été déplacé ?\n' >&2
  exit 1
fi

# shellcheck source=../lib/commun.sh
. "$CLIA_SOURCE_DIR/_scripts/lib/commun.sh"

# Le dépôt d'où l'on appelle, résolu une fois et sans exiger qu'il existe.
#
# Il est résolu ici, avant la fouille des commandes, parce que sa carte
# déclare les extensions — et les commandes qu'elles apportent doivent
# figurer dans l'aide au même titre que les autres. Hors d'un dépôt, la
# variable reste vide : la fouille se réduit alors au noyau et aux ressources
# du dépôt source, et la documentation répond quand même.
_CLIA_DEPOT_COURANT=$(_clia_depot_git "$PWD" 2>/dev/null || printf '')

# Les zones que les ressources déclarent, lues une fois et exportées.
#
# Elles sont lues ici pour la même raison que le dépôt : la fouille des
# commandes s'en sert, et la relire à chaque appel triplait le temps de
# réponse. Voir _clia_memoriser_zones, et clia-config(1) pour ce qu'une zone
# est. SES-001 tâche 21.
_clia_memoriser_zones "$_CLIA_DEPOT_COURANT"

# --------------------------------------------------------------------------
# Les commandes, et leurs déclarations
# --------------------------------------------------------------------------

# Sortie : « nom<TAB>fichier<TAB>origine », dans l'ordre de fouille.
# L'origine vaut « noyau » ou « ressource » — SES-001 tâche 13 sépare les deux
# dans l'aide, et l'endroit où le fichier a été trouvé suffit à le dire.
#
# Trois fouilles, et le noyau d'abord. Une ressource apporte ses automatismes
# avec elle — c'est ce qui fait qu'ajouter une ressource ajoute ce qu'elle
# sait faire — mais elle ne peut pas masquer une commande du noyau : le
# premier trouvé l'emporte, et « version » ne doit pas changer de sens selon
# les ressources installées.
#
# Les deux dernières fouillent la zone des ressources livrées — celle que
# $CLIA_ZONE_RESSOURCE_LIVREE désigne, .clia/ressources par défaut. SES-001
# tâche 19 : seules les ressources installées sont accessibles par le CLI.
#
# Ce que cela écarte, et volontairement : ni un dépôt voisin, ni ce que le
# dépôt écrit sans l'avoir installé. Une ressource en cours d'écriture, sous
# $CLIA_ZONE_RESSOURCE, ne répond pas — l'installer est un geste, donc une
# trace. Voir clia-extension(1) et SPC-001-ontologie.
_clia_fichiers_de_commande() {
  local f zone
  zone=$(_clia_zone_livree)
  for f in "$CLIA_SOURCE_DIR"/_scripts/lib/cmd/*.sh; do
    [[ -f "$f" ]] && printf '%s\t%s\tnoyau\n' "$(basename "$f" .sh)" "$f"
  done
  for f in "$CLIA_SOURCE_DIR/$zone"/*/_scripts/*.sh; do
    [[ -f "$f" ]] && printf '%s\t%s\tressource\n' "$(basename "$f" .sh)" "$f"
  done
  if [[ -n "$_CLIA_DEPOT_COURANT" && "$_CLIA_DEPOT_COURANT" != "$CLIA_SOURCE_DIR" ]]; then
    for f in "$_CLIA_DEPOT_COURANT/$zone"/*/_scripts/*.sh; do
      [[ -f "$f" ]] && printf '%s\t%s\tressource\n' "$(basename "$f" .sh)" "$f"
    done
  fi
  return 0
}

# Le fichier qui porte une commande, ou rien. Le premier trouvé l'emporte.
#
# awk lit la liste jusqu'au bout plutôt que de sortir au premier résultat :
# sous « set -o pipefail », un awk qui referme le tube tôt fait recevoir
# SIGPIPE à la boucle en amont, et la commande entière sortirait en 141.
_clia_fichier_de() {
  _clia_fichiers_de_commande \
    | awk -F'\t' -v n="$1" '$1 == n && !vu { print $2; vu = 1 }'
}

# L'origine d'une commande — « noyau » ou « ressource ».
_clia_origine_de() {
  _clia_fichiers_de_commande \
    | awk -F'\t' -v n="$1" '$1 == n && !vu { print $3; vu = 1 }'
}

_clia_description_de() {
  grep -m1 -E '^#[[:space:]]*Description:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Description:[[:space:]]*//' || true
}

_clia_perimetre_de() {
  local declaration
  declaration=$(grep -m1 -E '^#[[:space:]]*Périmètre:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Périmètre:[[:space:]]*//' || true)
  printf '%s\n' "${declaration:-dépôt}"
}

# --------------------------------------------------------------------------
# Aide brève
# --------------------------------------------------------------------------
#
# Composée à partir de ce qui a été trouvé : elle ne peut donc pas annoncer
# une commande qui n'existe pas, ni taire une commande qui existe.
#
# Deux formes, et la tâche 13 les sépare.
#
# Au premier niveau, « clia --help » sert à trouver une commande. Il ne porte
# donc pas les signatures : elles y étaient une liste de quarante lignes qu'il
# fallait lire en entier pour découvrir qu'une commande existe. Il porte les
# commandes et ce que chacune fait, en une ligne — et les ressources à part
# des commandes du noyau, parce qu'on ne les cherche pas pour la même raison.
#
# Aux niveaux suivants, « clia <commande> --help » sert à employer une
# commande qu'on a déjà trouvée. Il porte donc ses signatures et ses options,
# et aucune phrase — SES-001 tâche 3. Une ligne y est un titre de bloc ou une
# entrée indentée de deux espaces, et rien d'autre. Ce qui explique appartient
# au manuel : clia --man.
#
# Le point d'entrée la rend pour tous les niveaux, y compris ceux d'une
# sous-commande, à partir des seules déclarations des fichiers. Une commande
# n'écrit donc pas son aide : elle déclare ses signatures, et l'aide en
# découle. C'est la même raison qui fait appliquer la garde de périmètre ici
# plutôt que dans chaque commande — ce qui est uniforme se tient à un seul
# endroit.

# Une entrée de l'aide générale : le nom, aligné, puis la description
# déclarée. La largeur est fixe pour que les descriptions s'alignent ; un nom
# plus long qu'elle la déborde plutôt que d'être tronqué — un nom tronqué ne
# désigne plus la commande.
_CLIA_LARGEUR_NOM=10

_clia_entree_de_commande() {
  local nom="$1" desc
  desc=$(_clia_description_de "$2")
  if [[ -z "$desc" ]]; then
    printf '%s\n' "$nom"
  else
    printf '%-*s %s\n' "$_CLIA_LARGEUR_NOM" "$nom" "$desc"
  fi
}

_CLIA_SIGNATURES_GLOBALES=(
  '[-h | --help | --man | -v | --version]'
  '<commande> [-h | --help | --man]'
)

# Toutes les signatures déclarées, celles du CLI puis celles des commandes.
_clia_toutes_signatures() {
  local s f nom
  for s in "${_CLIA_SIGNATURES_GLOBALES[@]}"; do printf '%s\n' "$s"; done
  while IFS=$'\t' read -r nom f _; do
    _clia_signatures_de "$f"
  done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
}

# _clia_aide <chemin> — l'aide brève, restreinte aux signatures qui
# commencent par ce chemin. Un chemin vide rend l'aide générale.
_clia_aide() {
  local chemin="${1:-}" f nom commandes=() options=()

  if [[ -z "$chemin" ]]; then
    local origine vu='' ressources=()
    while IFS=$'\t' read -r nom f origine; do
      # Le premier trouvé l'emporte, ici comme au dispatch : une commande
      # masquée ne doit pas paraître deux fois dans l'aide.
      [[ " $vu " == *" $nom "* ]] && continue
      vu="$vu $nom"
      if [[ "$origine" == 'ressource' ]]; then
        ressources+=("$(_clia_entree_de_commande "$nom" "$f")")
      else
        commandes+=("$(_clia_entree_de_commande "$nom" "$f")")
      fi
    done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
    _clia_bloc 'Commandes' "${commandes[@]}"
    _clia_bloc 'Ressources' "${ressources[@]}"
    _clia_bloc 'Options' "${_CLIA_OPTIONS_GLOBALES[@]}"
    return 0
  fi

  f=$(_clia_fichier_de "${chemin%% *}")
  printf 'Usage :\n'
  { _clia_signatures_de "$f"
    # Les verbes génériques des ressources ne sont déclarés dans aucun
    # fichier : c'est le point d'entrée qui les tient, pour toutes. Ils
    # doivent donc être ajoutés ici, sinon l'aide tairait des formes d'appel
    # valides.
    if [[ "$(_clia_origine_de "${chemin%% *}")" == 'ressource' ]]; then
      printf '%s provide\n'                                     "${chemin%% *}"
      printf '%s check [--explain]\n'                            "${chemin%% *}"
      printf '%s prim ls [-1 | -2]\n'                            "${chemin%% *}"
      printf '%s prim check [IDENTIFIANT]\n'                     "${chemin%% *}"
      printf '%s prim IDENTIFIANT ls\n'                          "${chemin%% *}"
      printf '%s prim IDENTIFIANT set CLE VALEUR\n'              "${chemin%% *}"
      printf '%s zone ls [--ressource | --generated | --delivered] [IDENTIFIANT]\n' "${chemin%% *}"
      printf '%s make [CIBLE…]\n'                                "${chemin%% *}"
      printf '%s make ls\n'                                      "${chemin%% *}"
      printf '%s make config ls\n'                               "${chemin%% *}"
      printf '%s make [--check | --explain | --man]\n'           "${chemin%% *}"
      printf '%s upgrade [--migrate] [VERSION]\n'                "${chemin%% *}"
      printf '%s downgrade [--migrate] [VERSION]\n'              "${chemin%% *}"
      printf '%s migrate [DE VERS]\n'                            "${chemin%% *}"
      printf '%s deactivate\n'                                   "${chemin%% *}"
    fi
  } | _clia_lignes_usage "$chemin"
  mapfile -t options < <(_clia_options_de "$f" | _clia_lignes_options "$chemin")
  options+=("${_CLIA_OPTIONS_UNIVERSELLES[@]}")
  _clia_bloc 'Options' "${options[@]}"
}

# --------------------------------------------------------------------------
# Manuel
# --------------------------------------------------------------------------

_clia_manuel() {
  local nom f desc
  {
    cat <<'EOF'
NOM
clia - système d'information collaboratif entre humains, automatismes et
intelligences artificielles

SYNOPSIS
EOF
    _clia_toutes_signatures | _clia_lignes_usage '' | sed 's/^  //'
    cat <<'EOF'

DESCRIPTION
clia outille un dépôt git. Il n'a pas de commande à lui : il les
trouve. Un fichier portant ses déclarations en tête apparaît dans
l'aide et devient invocable, sans qu'aucun fichier du noyau soit
modifié.

Trois endroits sont fouillés : _scripts/lib/cmd/ pour le noyau,
_ressources/<nom>/_scripts/ du dépôt source pour ce que le CLI
porte, et le même répertoire du dépôt de travail pour ce que
celui-ci porte. Le noyau l'emporte en cas d'homonymie, puis les
ressources du CLI : une ressource ajoute, elle ne remplace pas.

Une ressource arrive dans un dépôt de travail de deux façons : clia
res new la crée, ou clia extension install la reprend d'une
extension. Dans les deux cas elle est là, versionnée avec le dépôt.

clia n'exécute rien depuis un dépôt voisin. Déclarer une extension
dit d'où des ressources peuvent venir ; il faut les installer pour
qu'elles répondent, et l'installation les dépose ici. Voir
clia-extension(1) et clia-source(1).

Une commande déclare son périmètre. Celles dont le périmètre est
« dépôt » n'agissent que dans un dépôt git, et le point d'entrée le
résout avant de leur passer la main. Une déclaration absente vaut
« dépôt » : l'oubli restreint, il n'ouvre jamais.

La sortie standard ne porte que ce qu'un autre programme viendrait
lire. Tout le reste — diagnostics, avertissements, refus — va sur la
sortie d'erreur. Une commande dont la sortie tient sur une ligne peut
donc être lue par une autre sans être filtrée.

COMMANDES
EOF
    while IFS=$'\t' read -r nom f _; do
      desc=$(_clia_description_de "$f")
      printf '%s\n' "$nom"
      printf '       %s\n' "${desc:-(sans description)}"
      printf '       Le manuel de cette commande : clia %s --man\n' "$nom"
    done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
    cat <<'EOF'

OPTIONS
-h, --help
       L'aide brève du niveau demandé. Sans commande, les commandes du
       noyau et les ressources, chacune avec ce qu'elle fait en une
       ligne. Avec une commande, ses signatures valides et ses options,
       sans aucune prose. Elle est acceptée à tout niveau, y compris
       celui d'une sous-commande.

--man
       Le manuel complet, au format des pages de manuel unix. Sans
       commande, celui de clia ; avec une commande, le sien.

-v, --version
       Équivaut à « clia version ». SES-001 pose que la version du
       CLI est celle du système d'information qu'il outille ; deux
       orthographes du même mot ne doivent pas désigner deux objets.
       Reconnue en première position seulement.

LES VERBES DES RESSOURCES
Huit verbes valent pour toute commande de ressource, et le point
d'entrée les tient pour toutes. Une ressource reprise d'une
extension les reçoit sans avoir eu à les écrire.

prim ls [-1 | -2]
prim check [IDENTIFIANT]
prim IDENTIFIANT ls
prim IDENTIFIANT set CLE VALEUR
       Les primitives de l'instance que ce dépôt écrit — ce à
       partir de quoi la ressource est produite. SES-001 tâche 22.

       « ls » les liste avec leur ordre, leur structure, leur
       origine et qui les édite ; « -1 » et « -2 » restreignent à
       un ordre. « check » vérifie ce qui se vérifie d'elles.

       Une primitive porte un identifiant PREFIXE-SEQ, de la même
       forme qu'une instance : une primitive est une ressource, à
       un stade. « prim IDENTIFIANT ls » dit ce qu'elle déclare, et
       « set » le pose dans le fichier lui-même.

       Deux clés se déclarent : « origine » (depot, externe) et
       « editeur » (humain, agent, automatisme). L'identifiant,
       l'ordre et la structure se déduisent du fichier, et ne se
       déclarent donc pas.

zone ls [--ressource | --generated | --delivered] [IDENTIFIANT]
       Où chaque stade de la ressource vit dans ce dépôt :
       l'instance et ses primitives, ce qui est généré, ce qui est
       livré, et la copie installée.

       Avec un identifiant, la zone de cette primitive-là.

make [CIBLE…]
make ls
make config ls
make [--check | --explain | --man]
       Construire le stade généré à partir des primitives.

       clia ne construit rien lui-même : il lance make(1) dans
       l'instance, dont le Makefile porte les règles et dont
       genere/ reçoit ce qu'elles produisent. « ls » rend ce qui
       serait fait, « --check » demande à make si c'est à jour.

       « generate » nomme le même verbe. L'énoncé de SES-001
       tâche 22 proposait aussi « gen » ; il n'est pas repris,
       parce que « clia hrn gen » existe déjà et désigne autre
       chose — un verbe générique qui masquerait un verbe de
       ressource ferait disparaître une commande sans le dire.

       Le manuel complet : clia <ressource> make --man.

check [--explain]
       La conformité de la ressource : ses zones, la forme de sa
       définition, les primitives que sa livraison déclare, les
       scripts de migration que son historique appelle, et la
       version en place au regard de la dernière disponible.

       « --explain » ajoute, sous chaque verdict, ce que le
       contrôle vérifie et pourquoi.

       Rien n'est écrit : constater n'est pas réparer.

provide [ls]
       Ce que la ressource apporte : ses fonctionnalités, ses
       skills, ses scripts, et l'état de chacun dans ce dépôt. Voir
       clia-feature(1), clia-skill(1) et clia-script(1), qui
       posent et retirent.

upgrade [--with-instances | --migrate] [--force] [VERSION]
downgrade [--with-instances | --migrate] [--force] [VERSION]
       Reprend la ressource à une autre version, depuis l'extension
       dont elle vient. Sans version, la plus récente que cette
       extension déclare.

       « upgrade » exige une cible supérieure, « downgrade » une
       cible inférieure. Voir clia-upgrade(1).

migrate [DE VERS]
       Fait franchir à ses instances les sauts de version, en
       lançant les scripts que la ressource porte sous
       migrations/. Sans versions, du numéro que l'inventaire a
       inscrit à celui que la définition déclare.

deactivate
       Retire la ressource du dépôt de travail, et l'ôte de
       l'inventaire de la carte.

       Il refuse de retirer ce que le dépôt publie, ce qui n'est pas
       installé chez lui, et ce que git ne tient pas encore. Voir
       clia-extension(1).

CODE DE RETOUR
0
       La demande est satisfaite, même s'il n'y avait rien à faire.

1
       Refus. La demande est comprise, et clia ne la satisfait pas : hors
       d'un dépôt git, pré-condition non tenue, ou rien à rapporter.

2
       Demande mal formée. L'appelant doit reformuler.

ENVIRONNEMENT
clia se règle par l'environnement, et par rien d'autre. Ce qui
suit nomme ce que le noyau tient ; « clia config ls » rend l'état
réel, y compris les zones que les ressources installées
déclarent. Voir clia-config(1).

CLIA_ZONE_<NOM>
       L'emplacement d'une zone — l'endroit où une ressource écrit.
       La ressource la déclare dans sa définition, et la variable
       se déduit du nom : CLIA_ZONE_, puis le nom en majuscules,
       les tirets changés en soulignés.

       Une zone arrive donc avec la ressource qui écrit dedans,
       comme ses scripts et ses skills. Deux exceptions : la zone
       livrée, qu'il faut connaître pour trouver une ressource, et
       la zone des instances en dernier recours.

CLIA_SOURCE_DIR
       Le dépôt d'où vient le code exécuté. Résolu par le point d'entrée,
       les liens symboliques suivis, et exporté vers la commande.

CLIA_WORK_DIR
       Le dépôt sur lequel la commande travaille. Posé par le point
       d'entrée pour les commandes de périmètre « dépôt » seulement.

CLIA_EXECUTABLE
       Le chemin par lequel clia a été appelé.

CLIA_INSTALLATION
       La nature de l'installation en place, posée par setup.sh. Son
       absence signifie que clia est appelé par son chemin, hors de
       toute installation.

CLIA_ZONE_RESSOURCE
       Où le dépôt écrit ses ressources : une instance par
       répertoire, sous <PREFIXE>-<SEQ>-<SLUG>/. Par défaut
       .dev/ressources.

CLIA_POLICY_ROLLING_RESSOURCE
       À « true », une ressource qui n'est pas à la dernière version
       disponible devient un écart bloquant pour « clia <ressource>
       check ». Par défaut « false » : c'est un signalement.

CLIA_ZONE_RESSOURCE_LIVREE
       Où le dépôt tient les ressources qu'il a installées. Par
       défaut .clia/ressources. C'est la seule zone où le CLI
       cherche ses commandes : une ressource écrite et non
       installée ne répond pas.

CLIA_PORTEE
       Le seul dépôt sur lequel l'installation permet de travailler.
       Une commande de périmètre « dépôt » lancée ailleurs est
       refusée ; la documentation, elle, répond partout.

       Sans installation, aucune portée n'est déclarée et rien ne
       restreint. La restriction appartient à l'installation, non au
       CLI. Voir clia-setup(1).

FICHIERS
setup.sh
       La gestion d'une installation. « . setup.sh activate » rend
       clia disponible dans le shell courant, pour un dépôt.

clia.yaml, .clia.yaml, .dev/clia.yaml
       La carte du dépôt : ce qu'il est, et ce qu'il tient
       d'ailleurs. Les trois emplacements sont cherchés dans cet
       ordre, et le premier trouvé l'emporte.

       Son champ « clia-version: » dit quelle version de clia le
       dépôt suit. Voir clia-upgrade(1).

_scripts/lib/cmd/*.sh
       Les commandes du noyau. Chaque fichier porte ses déclarations
       en tête : Description, Périmètre, Signature et Option.


<zone livrée>/*/_scripts/*.sh
       Les commandes que les ressources installées apportent.

~/.cache/clia/extensions/<namespace>
       Le clone d'une extension distante, propre à cette machine.
       La carte, elle, ne porte que l'URI. Voir clia-extension(1).

focus/
       Des liens vers ce qui compte pour le travail en cours. Hors
       de l'index de git : le focus est ce que quelqu'un regarde,
       non ce que le dépôt est. Voir clia-focus(1).

EXEMPLES
Rendre l'alias de version lisible du dépôt courant :

       $ clia version
       0.3.0

Lire le manuel d'une commande :

       $ clia version --man

VOIR AUSSI
clia-version(1), clia-res(1), clia-extension(1), clia-source(1),
clia-feature(1), clia-skill(1), clia-script(1), clia-focus(1),
clia-unfocus(1), clia-upgrade(1), clia-downgrade(1), clia-check(1),
clia-init(1), clia-hrn(1), clia-setup(1), git(1)
EOF
  } | _clia_man clia 1 "Manuel de l'utilisateur clia"
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

case "${1:-}" in
  ''|-h|--help|help) _clia_aide; exit 0 ;;
  --man)             _clia_manuel; exit 0 ;;
  # -v et --version ne sont pas une commande à part : SES-001 tâche 1 pose
  # que la version du CLI est celle du SI. Deux orthographes pour un même
  # objet doivent rendre la même chose, sinon le mot « version » désigne deux
  # choses selon le nombre de tirets qui le précèdent.
  -v|--version)      set -- version ;;
esac

COMMANDE="$1"
shift

# Le nom est comparé à des noms de fichiers : il est restreint pour qu'il ne
# puisse désigner qu'une commande — ni « / », ni « .. ».
if [[ ! "$COMMANDE" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  _clia_msg "nom de commande invalide : $COMMANDE"
  _clia_detail "la liste des commandes : clia --help"
  exit 2
fi

FICHIER=$(_clia_fichier_de "$COMMANDE")
if [[ -z "$FICHIER" ]]; then
  _clia_msg "commande inconnue : $COMMANDE"
  _clia_detail "la liste des commandes : clia --help"
  exit 2
fi

# Une demande de documentation est reconnue ici, à n'importe quelle
# profondeur : « clia version release --help » doit répondre comme « clia
# version --help ». Le chemin retenu est fait des arguments qui précèdent, et
# les options n'en font pas partie — elles nomment une variante d'appel, pas
# un niveau de commande.
CHEMIN="$COMMANDE"
DEMANDE_AIDE=0
DEMANDE_MAN=0
for _arg in "$@"; do
  case "$_arg" in
    -h|--help) DEMANDE_AIDE=1; break ;;
    --man)     DEMANDE_MAN=1;  break ;;
    -*)        ;;
    *)         CHEMIN="$CHEMIN $_arg" ;;
  esac
done

if (( DEMANDE_AIDE )); then
  _clia_aide "$CHEMIN"
  exit 0
fi

# Le périmètre est résolu ici, une fois, plutôt que dans chaque commande :
# une commande nouvelle en hérite sans rien déclarer.
#
# La documentation y échappe : un manuel ne dépend d'aucun dépôt, et exiger
# d'être dans un dépôt git pour lire une page de manuel rendrait inaccessible
# ce que la tâche 3 veut justement accessible partout.
if (( ! DEMANDE_MAN )) && [[ "$(_clia_perimetre_de "$FICHIER")" == 'dépôt' ]]; then
  CLIA_WORK_DIR="$_CLIA_DEPOT_COURANT"
  if [[ -z "$CLIA_WORK_DIR" ]]; then
    _clia_msg "le répertoire courant n'est pas dans un dépôt git"
    _clia_detail "clia $COMMANDE agit sur un dépôt ; placez-vous dans l'un d'eux"
    exit 1
  fi

  # La portée d'une installation, quand il y en a une. Une activation vaut
  # pour un seul dépôt de travail — SES-001 tâche 4 — et travailler ailleurs
  # sans s'en apercevoir est précisément ce qu'elle sert à empêcher.
  #
  # Sans installation, aucune portée n'est déclarée et rien ne restreint :
  # c'est le cas quand clia est appelé par son chemin, depuis son dépôt
  # source. La restriction appartient à l'installation, non au CLI.
  if [[ -n "${CLIA_PORTEE:-}" && "$CLIA_WORK_DIR" != "$CLIA_PORTEE" ]]; then
    _clia_msg "hors de la portée de l'installation en cours"
    _clia_detail "portée : $CLIA_PORTEE"
    _clia_detail "ici    : $CLIA_WORK_DIR"
    _clia_detail "pour travailler ici : . setup.sh -C . activate"
    exit 1
  fi

  export CLIA_WORK_DIR
fi

# Le verbe générique des ressources, tenu ici pour toutes.
#
# SES-001 tâche 11 : « ajouter une commande générique à toutes les ressources
# permettant de désinstaller la ressource ». Retirer une ressource n'est pas
# ce qu'une ressource sait faire — c'est ce que le dépôt fait d'une ressource
# — et le geste est le même pour toutes. Une ressource reprise d'une
# extension le reçoit donc sans avoir eu à l'écrire.
#
# Ils agissent sur un dépôt, quel que soit le périmètre que la ressource
# déclare pour elle-même : une ressource peut n'avoir besoin d'aucun dépôt
# pour travailler, et être installée dans l'un d'eux. Le dépôt est donc résolu
# ici, et son absence refusée ici.
if [[ "$(_clia_origine_de "$COMMANDE")" == 'ressource' ]] \
   && [[ "${1:-}" =~ ^(deactivate|provide|check|prim|primitive|zone|make|generate|upgrade|downgrade|migrate)$ ]]; then
  _CLIA_VERBE="$1"; shift

  case "$_CLIA_VERBE" in
    deactivate)
      (( $# == 0 )) || { _clia_msg "deactivate ne prend pas d'argument : $*"; exit 2; } ;;
    provide)
      # « provide » et « provide ls » disent la même chose : l'énoncé écrit le
      # second, et un verbe qui n'a qu'une forme n'a pas à l'exiger.
      (( $# == 0 )) || [[ "${1:-}" == 'ls' && $# -eq 1 ]] || {
        _clia_msg "provide n'accepte que « ls » : $*"; exit 2; } ;;
  esac

  if [[ -z "${CLIA_WORK_DIR:-}" ]]; then
    if [[ -z "$_CLIA_DEPOT_COURANT" ]]; then
      _clia_msg "le répertoire courant n'est pas dans un dépôt git"
      _clia_detail "$_CLIA_VERBE agit sur un dépôt ; placez-vous dans l'un d'eux"
      exit 1
    fi
    CLIA_WORK_DIR="$_CLIA_DEPOT_COURANT"
    export CLIA_WORK_DIR
  fi

  # shellcheck source=../lib/ressource.sh
  . "$CLIA_SOURCE_DIR/_scripts/lib/ressource.sh"
  case "$_CLIA_VERBE" in
    deactivate)          _clia_r_desactiver "$COMMANDE" "$FICHIER" ;;
    provide)             _clia_r_provide    "$COMMANDE" "$FICHIER" ;;
    check)
      # shellcheck source=../lib/conformite.sh
      . "$CLIA_SOURCE_DIR/_scripts/lib/conformite.sh"
      _clia_c_verifier "$COMMANDE" "$FICHIER" "$@" ;;
    prim|primitive)
      # shellcheck source=../lib/stade.sh
      . "$CLIA_SOURCE_DIR/_scripts/lib/stade.sh"
      _clia_s_prim "$COMMANDE" "$FICHIER" "$@" ;;
    zone)
      # shellcheck source=../lib/stade.sh
      . "$CLIA_SOURCE_DIR/_scripts/lib/stade.sh"
      _clia_s_zone "$COMMANDE" "$FICHIER" "$@" ;;
    make|generate)
      # shellcheck source=../lib/generation.sh
      . "$CLIA_SOURCE_DIR/_scripts/lib/generation.sh"
      _clia_g_make "$COMMANDE" "$FICHIER" "$@" ;;
    upgrade|downgrade)   _clia_r_maj        "$COMMANDE" "$FICHIER" "$_CLIA_VERBE" "$@" ;;
    migrate)             _clia_r_migrer     "$COMMANDE" "$FICHIER" "$@" ;;
  esac
  exit $?
fi

# Un verbe désactivé — SES-001 tâche 15.
#
# Le refus vient d'ici, et non de la commande : c'est le même endroit que la
# garde de périmètre, et pour la même raison. Une ressource n'a rien à écrire
# pour que ses verbes puissent être refusés, et une ressource reprise d'une
# extension l'est comme les autres.
#
# La lecture n'a lieu que si la carte porte un bloc « desactives: ». L'état
# ordinaire d'un verbe est de répondre, et il ne doit rien coûter.
#
# C'est la carte du dépôt où l'on se trouve qui décide, quel que soit le
# périmètre que la ressource déclare pour elle-même : une ressource peut
# n'avoir besoin d'aucun dépôt pour travailler, et son verbe être refusé
# ici.
if [[ -n "${1:-}" && "${1:0:1}" != '-' \
      && "$(_clia_origine_de "$COMMANDE")" == 'ressource' \
      && -n "$_CLIA_DEPOT_COURANT" ]]; then
  if _CLIA_CARTE=$(_clia_carte "$_CLIA_DEPOT_COURANT") \
     && grep -q '^desactives:' "$_CLIA_CARTE" 2>/dev/null; then
    # La zone livrée compte plusieurs segments : elle est retirée par son
    # nom, non en comptant des répertoires. Compter aurait lié ce calcul à
    # la profondeur d'un chemin que l'environnement règle.
    _CLIA_ZONE_LIV=$(_clia_zone_livree)
    _CLIA_NOM_RES="${FICHIER#*/"$_CLIA_ZONE_LIV"/}"; _CLIA_NOM_RES="${_CLIA_NOM_RES%%/*}"
    _CLIA_RACINE_RES="${FICHIER%/"$_CLIA_ZONE_LIV"/*}"
    _CLIA_PREFIXE=$(_clia_champ_yaml \
      "$_CLIA_RACINE_RES/$_CLIA_ZONE_LIV/$_CLIA_NOM_RES/$_CLIA_NOM_RES.yaml" prefixe || printf '')
    if [[ -n "$_CLIA_PREFIXE" ]]; then
      while IFS="$_CLIA_SEP" read -r _CLIA_ID; do
        [[ "$_CLIA_ID" == "$_CLIA_PREFIXE/$1" ]] || continue
        _clia_msg "le script « $1 » est désactivé dans ce dépôt"
        _clia_detail "inscrit dans ${_CLIA_CARTE#"$_CLIA_DEPOT_COURANT"/}, sous « desactives: »"
        _clia_detail "pour le rendre : clia script activate $1 $_CLIA_PREFIXE"
        exit 1
      done < <(_clia_bloc_yaml "$_CLIA_CARTE" desactives script)
    fi
  fi
fi

exec bash "$FICHIER" "$@"

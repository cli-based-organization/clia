#!/usr/bin/env bash
# _scripts/bin/clia — le CLI du système d'information clia.
#
# Ce fichier ne porte aucune commande : il les trouve. Une commande est un
# fichier <nom>.sh portant deux lignes de déclaration :
#
#   # Description: ce que la commande fait, en une ligne
#   # Périmètre: dépôt | aucun
#
# Deux emplacements sont fouillés, et REQ-002 dit lequel selon la nature de
# la commande :
#
#   _scripts/lib/cmd/<nom>.sh              une commande du CLI lui-même
#   _ressources/<nom>/scripts/<nom>.sh     une commande propre à une ressource
#
# Déposer un fichier à l'un ou l'autre suffit à l'exposer dans l'aide et à le
# rendre invocable. Le mécanisme est emprunté à _scripts/clia du dépôt
# noumanity-wiki ; le champ Périmètre lui est ajouté, parce que clia — à la
# différence de ce dépôt-là — travaille sur un dépôt qui n'est pas le sien.
#
#   Périmètre: dépôt   la commande agit sur le dépôt git courant. Le
#                      dispatcher le résout, applique la garde du mode
#                      --activate, et le passe dans CLIA_WORK_DIR.
#   Périmètre: aucun   la commande n'agit sur aucun dépôt (setup).
#
# Sans déclaration, le périmètre vaut « dépôt » : oublier la ligne restreint,
# et ne dispense jamais de la garde.

set -euo pipefail

_CLIA_NOM='clia'

# --------------------------------------------------------------------------
# Amorçage
# --------------------------------------------------------------------------
#
# En mode --dev, ce fichier est atteint par un lien symbolique depuis le
# répertoire des exécutables de l'utilisateur. Ses modules sont dans le dépôt
# source, pas à côté du lien : il faut donc résoudre les liens avant de
# chercher _scripts/lib. La même résolution existe dans _scripts/lib/commun.sh,
# mais elle ne peut pas servir ici — c'est elle qu'il s'agit d'aller chercher.

_clia_amorcer() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  printf '%s\n' "${dir%/_scripts/bin}"
}

CLIA_SOURCE_DIR=$(_clia_amorcer)
# Le chemin par lequel la commande a été appelée : un lien en mode --dev, le
# fichier lui-même sinon. Les modules le rapportent à l'humain, et ne
# pourraient pas le retrouver seuls une fois lancés par le dispatcher.
CLIA_EXECUTABLE="${BASH_SOURCE[0]}"
export CLIA_SOURCE_DIR CLIA_EXECUTABLE

if [[ ! -f "$CLIA_SOURCE_DIR/_scripts/lib/commun.sh" ]]; then
  printf 'clia: _scripts/lib/commun.sh est introuvable sous %s\n' "$CLIA_SOURCE_DIR" >&2
  printf '      le dépôt source a-t-il été déplacé ? relancez : . setup.sh install --dev --force\n' >&2
  exit 1
fi

# shellcheck source=../lib/commun.sh
. "$CLIA_SOURCE_DIR/_scripts/lib/commun.sh"

# --------------------------------------------------------------------------
# Les commandes, et leurs déclarations
# --------------------------------------------------------------------------

# Les fichiers de commande, dans l'ordre où ils sont fouillés : le CLI
# d'abord, les ressources ensuite. Un même nom aux deux endroits n'a pas de
# sens — le premier trouvé l'emporte, et clia le signale plutôt que de
# choisir en silence.
# Sortie : « nom<TAB>fichier », dans l'ordre de fouille. Le nom est celui du
# fichier ; les alias sont résolus à part, pour que l'aide n'affiche chaque
# commande qu'une fois.
_clia_fichiers_de_commande() {
  local f
  # Le second motif de ressource couvre les catégories : une ressource peut
  # vivre sous l'une d'elles. SPC-001 S2 arrête la profondeur à deux.
  for f in "$CLIA_SOURCE_DIR"/_scripts/lib/cmd/*.sh \
           "$CLIA_SOURCE_DIR"/_ressources/*/scripts/*.sh \
           "$CLIA_SOURCE_DIR"/_ressources/*/*/scripts/*.sh; do
    [[ -f "$f" ]] && printf '%s\t%s\n' "$(basename "$f" .sh)" "$f"
  done
  return 0
}

# Le fichier qui porte une commande, ou rien. Le premier trouvé l'emporte.
# Le nom de fichier d'abord, puis les alias déclarés.
#
# awk lit la liste jusqu'au bout plutôt que de sortir au premier match : sous
# « set -o pipefail », un awk qui referme le tube tôt fait recevoir SIGPIPE à
# la boucle en amont, et la commande entière sortirait en 141.
_clia_fichier_de() {
  local demande="$1" trouve nom f
  trouve=$(_clia_fichiers_de_commande \
    | awk -F'\t' -v n="$demande" '$1 == n && !vu { print $2; vu = 1 }')
  if [[ -n "$trouve" ]]; then
    printf '%s\n' "$trouve"
    return 0
  fi
  while IFS=$'\t' read -r nom f; do
    for a in $(_clia_alias_de "$f"); do
      if [[ "$a" == "$demande" ]]; then
        printf '%s\n' "$f"
        return 0
      fi
    done
  done < <(_clia_fichiers_de_commande)
  return 0
}

_clia_description_de() {
  grep -m1 -E '^#[[:space:]]*Description:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Description:[[:space:]]*//' || true
}

_clia_perimetre_de() {
  local declaration
  declaration=$(grep -m1 -E '^#[[:space:]]*Périmètre:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Périmètre:[[:space:]]*//' || true)
  printf '%s\n' "${declaration:-dépôt}"
}

# Les autres noms sous lesquels une commande répond, séparés par des espaces.
# USE-003 écrit « clia res|ressource ls » : les trois noms désignent la même
# commande, et un seul fichier la porte.
_clia_alias_de() {
  grep -m1 -E '^#[[:space:]]*Alias:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Alias:[[:space:]]*//' || true
}

# --------------------------------------------------------------------------
# Aide
# --------------------------------------------------------------------------

_clia_aide() {
  cat <<EOF
clia $_CLIA_VERSION — système d'information collaboratif entre humains,
automatismes et intelligences artificielles.

Usage : clia <commande> [arguments]

Commandes :
EOF
  local nom f desc vus=' '
  while IFS=$'\t' read -r nom f; do
    if [[ "$vus" == *" $nom "* ]]; then
      printf '  %-12s (masquée : %s porte déjà ce nom)\n' "$nom" "$nom"
      continue
    fi
    vus+="$nom "
    desc=$(_clia_description_de "$f")
    printf '  %-12s %s\n' "$nom" "${desc:-(sans description)}"
  done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
  cat <<'EOF'

Options :
  -h, --help        cette aide
  -v, --version     la version

Aide d'une commande :
  clia <commande> --help

Installer clia se fait depuis son dépôt source :
  . setup.sh install --activate    ce shell, et le dépôt source seulement
  . setup.sh install --dev         toute session, et tout dépôt git

Codes de retour :
  0  la demande est satisfaite
  1  refus : hors périmètre, ou rien à faire
  2  demande mal formée
EOF
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

case "${1:-}" in
  ''|-h|--help|help) _clia_aide; exit 0 ;;
  -v|--version)      printf '%s\n' "$_CLIA_VERSION"; exit 0 ;;
esac

COMMANDE="$1"
shift

# Le nom est comparé à des noms de fichiers : il est restreint pour qu'il ne
# puisse désigner qu'une commande — ni « / », ni « .. ».
if [[ ! "$COMMANDE" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  _clia_msg "nom de commande invalide : $COMMANDE"
  exit 2
fi

FICHIER=$(_clia_fichier_de "$COMMANDE")
if [[ -z "$FICHIER" ]]; then
  _clia_msg "commande inconnue : $COMMANDE"
  _clia_detail "l'aide, et la liste des commandes : clia --help"
  exit 2
fi

# La garde du mode --activate s'applique ici, une fois, plutôt que dans
# chaque commande : une commande nouvelle en hérite sans rien déclarer.
if [[ "$(_clia_perimetre_de "$FICHIER")" == 'dépôt' ]]; then
  CLIA_WORK_DIR=$(_clia_depot_de_travail) || exit 1
  export CLIA_WORK_DIR
fi

exec bash "$FICHIER" "$@"

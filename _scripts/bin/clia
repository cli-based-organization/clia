#!/usr/bin/env bash
# _scripts/bin/clia — le CLI du système d'information clia.
#
# Ce fichier ne porte aucune commande : il les trouve. Une commande est un
# fichier <nom>.sh déposé sous _scripts/lib/cmd/, portant ses déclarations en
# tête :
#
#   # Description: ce que la commande fait, en une ligne
#   # Périmètre:   dépôt | aucun
#   # Signature:   une forme d'invocation valide       (répétable)
#   # Option:      <chemin> <option>                   (répétable)
#
# Déposer un fichier suffit à l'exposer dans l'aide et à le rendre invocable.
# Les deux dernières déclarations sont ce dont l'aide brève est faite : une
# commande ne rédige pas son aide, elle déclare ses formes valides.
#
# Pourquoi une découverte plutôt qu'une liste écrite. C'est le seul mécanisme
# que toutes les générations précédentes ont porté sans qu'aucune ne le
# conteste, et le seul qui rende l'extensibilité mécanique plutôt que
# déclarative : ajouter une commande ne demande pas de modifier ce fichier.
# La génération 4 en avait fait le constat après l'avoir éprouvé ; celle-ci
# part de là.
#
#   Périmètre: dépôt   la commande agit sur un dépôt git. Le point d'entrée
#                      le résout et le passe dans CLIA_WORK_DIR.
#   Périmètre: aucun   la commande n'a besoin d'aucun dépôt.
#
# Sans déclaration, le périmètre vaut « dépôt » : oublier la ligne restreint,
# et n'ouvre jamais.

set -euo pipefail

_CLIA_NOM='clia'

# --------------------------------------------------------------------------
# Amorçage
# --------------------------------------------------------------------------
#
# Ce fichier peut être atteint par un lien symbolique. Ses modules sont dans
# le dépôt source, pas à côté du lien : les liens sont donc suivis jusqu'au
# bout avant de chercher _scripts/lib.

_clia_amorcer() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  printf '%s\n' "${dir%/_scripts/bin}"
}

CLIA_SOURCE_DIR=$(_clia_amorcer)
CLIA_EXECUTABLE="${BASH_SOURCE[0]}"
export CLIA_SOURCE_DIR CLIA_EXECUTABLE

if [[ ! -f "$CLIA_SOURCE_DIR/_scripts/lib/commun.sh" ]]; then
  printf 'clia: _scripts/lib/commun.sh est introuvable sous %s\n' "$CLIA_SOURCE_DIR" >&2
  printf '      le dépôt source a-t-il été déplacé ?\n' >&2
  exit 1
fi

# shellcheck source=../lib/commun.sh
. "$CLIA_SOURCE_DIR/_scripts/lib/commun.sh"

# --------------------------------------------------------------------------
# Les commandes, et leurs déclarations
# --------------------------------------------------------------------------

# Sortie : « nom<TAB>fichier », dans l'ordre de fouille.
_clia_fichiers_de_commande() {
  local f
  for f in "$CLIA_SOURCE_DIR"/_scripts/lib/cmd/*.sh; do
    [[ -f "$f" ]] && printf '%s\t%s\n' "$(basename "$f" .sh)" "$f"
  done
  return 0
}

# Le fichier qui porte une commande, ou rien. Le premier trouvé l'emporte.
#
# awk lit la liste jusqu'au bout plutôt que de sortir au premier résultat :
# sous « set -o pipefail », un awk qui referme le tube tôt fait recevoir
# SIGPIPE à la boucle en amont, et la commande entière sortirait en 141.
_clia_fichier_de() {
  _clia_fichiers_de_commande \
    | awk -F'\t' -v n="$1" '$1 == n && !vu { print $2; vu = 1 }'
}

_clia_description_de() {
  grep -m1 -E '^#[[:space:]]*Description:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Description:[[:space:]]*//' || true
}

_clia_perimetre_de() {
  local declaration
  declaration=$(grep -m1 -E '^#[[:space:]]*Périmètre:' "$1" 2>/dev/null \
    | sed -E 's/^#[[:space:]]*Périmètre:[[:space:]]*//' || true)
  printf '%s\n' "${declaration:-dépôt}"
}

# --------------------------------------------------------------------------
# Aide brève
# --------------------------------------------------------------------------
#
# Composée à partir de ce qui a été trouvé : elle ne peut donc pas annoncer
# une commande qui n'existe pas, ni taire une commande qui existe.
#
# Elle ne porte aucune phrase — SES-001 tâche 3. Une ligne y est un titre de
# bloc ou une entrée indentée de deux espaces, et rien d'autre. Ce qui
# explique appartient au manuel : clia --man.
#
# Le point d'entrée la rend pour tous les niveaux, y compris ceux d'une
# sous-commande, à partir des seules déclarations des fichiers. Une commande
# n'écrit donc pas son aide : elle déclare ses signatures, et l'aide en
# découle. C'est la même raison qui fait appliquer la garde de périmètre ici
# plutôt que dans chaque commande — ce qui est uniforme se tient à un seul
# endroit.

_CLIA_SIGNATURES_GLOBALES=(
  '[-h | --help | --man | -v | --version]'
  '<commande> [-h | --help | --man]'
)

# Toutes les signatures déclarées, celles du CLI puis celles des commandes.
_clia_toutes_signatures() {
  local s f nom
  for s in "${_CLIA_SIGNATURES_GLOBALES[@]}"; do printf '%s\n' "$s"; done
  while IFS=$'\t' read -r nom f; do
    _clia_signatures_de "$f"
  done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
}

# _clia_aide <chemin> — l'aide brève, restreinte aux signatures qui
# commencent par ce chemin. Un chemin vide rend l'aide générale.
_clia_aide() {
  local chemin="${1:-}" f nom commandes=() options=()

  if [[ -z "$chemin" ]]; then
    _clia_toutes_signatures | _clia_lignes_usage '' | sed '1i Usage :'
    while IFS=$'\t' read -r nom f; do
      commandes+=("$nom")
    done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
    _clia_bloc 'Commandes' "${commandes[@]}"
    _clia_bloc 'Options' "${_CLIA_OPTIONS_GLOBALES[@]}"
    return 0
  fi

  f=$(_clia_fichier_de "${chemin%% *}")
  printf 'Usage :\n'
  _clia_signatures_de "$f" | _clia_lignes_usage "$chemin"
  mapfile -t options < <(_clia_options_de "$f" | _clia_lignes_options "$chemin")
  options+=("${_CLIA_OPTIONS_UNIVERSELLES[@]}")
  _clia_bloc 'Options' "${options[@]}"
}

# --------------------------------------------------------------------------
# Manuel
# --------------------------------------------------------------------------

_clia_manuel() {
  local nom f desc
  {
    cat <<'EOF'
NOM
clia - système d'information collaboratif entre humains, automatismes et
intelligences artificielles

SYNOPSIS
EOF
    _clia_toutes_signatures | _clia_lignes_usage '' | sed 's/^  //'
    cat <<'EOF'

DESCRIPTION
clia outille un dépôt git. Il n'a pas de commande à lui : il les
trouve. Un fichier déposé sous _scripts/lib/cmd/ et portant ses
déclarations en tête apparaît dans l'aide et devient invocable, sans
qu'aucun fichier du noyau soit modifié.

Une commande déclare son périmètre. Celles dont le périmètre est
« dépôt » n'agissent que dans un dépôt git, et le point d'entrée le
résout avant de leur passer la main. Une déclaration absente vaut
« dépôt » : l'oubli restreint, il n'ouvre jamais.

La sortie standard ne porte que ce qu'un autre programme viendrait
lire. Tout le reste — diagnostics, avertissements, refus — va sur la
sortie d'erreur. Une commande dont la sortie tient sur une ligne peut
donc être lue par une autre sans être filtrée.

COMMANDES
EOF
    while IFS=$'\t' read -r nom f; do
      desc=$(_clia_description_de "$f")
      printf '%s\n' "$nom"
      printf '       %s\n' "${desc:-(sans description)}"
      printf '       Le manuel de cette commande : clia %s --man\n' "$nom"
    done < <(_clia_fichiers_de_commande | sort -t"$(printf '\t')" -k1,1)
    cat <<'EOF'

OPTIONS
-h, --help
       L'aide brève du niveau demandé : les signatures valides et les
       options disponibles, sans aucune prose. Elle est acceptée à tout
       niveau, y compris celui d'une sous-commande.

--man
       Le manuel complet, au format des pages de manuel unix. Sans
       commande, celui de clia ; avec une commande, le sien.

-v, --version
       Équivaut à « clia version ». SES-001 pose que la version du
       CLI est celle du système d'information qu'il outille ; deux
       orthographes du même mot ne doivent pas désigner deux objets.
       Reconnue en première position seulement.

CODE DE RETOUR
0
       La demande est satisfaite, même s'il n'y avait rien à faire.

1
       Refus. La demande est comprise, et clia ne la satisfait pas : hors
       d'un dépôt git, pré-condition non tenue, ou rien à rapporter.

2
       Demande mal formée. L'appelant doit reformuler.

ENVIRONNEMENT
CLIA_SOURCE_DIR
       Le dépôt d'où vient le code exécuté. Résolu par le point d'entrée,
       les liens symboliques suivis, et exporté vers la commande.

CLIA_WORK_DIR
       Le dépôt sur lequel la commande travaille. Posé par le point
       d'entrée pour les commandes de périmètre « dépôt » seulement.

CLIA_EXECUTABLE
       Le chemin par lequel clia a été appelé.

CLIA_INSTALLATION
       La nature de l'installation en place, posée par setup.sh. Son
       absence signifie que clia est appelé par son chemin, hors de
       toute installation.

CLIA_PORTEE
       Le seul dépôt sur lequel l'installation permet de travailler.
       Une commande de périmètre « dépôt » lancée ailleurs est
       refusée ; la documentation, elle, répond partout.

       Sans installation, aucune portée n'est déclarée et rien ne
       restreint. La restriction appartient à l'installation, non au
       CLI. Voir clia-setup(1).

FICHIERS
setup.sh
       La gestion d'une installation. « . setup.sh activate » rend
       clia disponible dans le shell courant, pour un dépôt.

clia.yaml, .clia.yaml, .dev/clia.yaml
       La carte du dépôt : ce qu'il est, et ce qu'il tient
       d'ailleurs. Les trois emplacements sont cherchés dans cet
       ordre, et le premier trouvé l'emporte.

_scripts/lib/cmd/*.sh
       Les commandes. Chaque fichier porte ses déclarations en tête :
       Description, Périmètre, Signature et Option.

EXEMPLES
Rendre l'alias de version lisible du dépôt courant :

       $ clia version
       0.3.0

Lire le manuel d'une commande :

       $ clia version --man

VOIR AUSSI
clia-version(1), clia-res(1), clia-check(1), clia-init(1),
clia-setup(1), git(1)
EOF
  } | _clia_man clia 1 "Manuel de l'utilisateur clia"
}

# --------------------------------------------------------------------------
# Dispatch
# --------------------------------------------------------------------------

case "${1:-}" in
  ''|-h|--help|help) _clia_aide; exit 0 ;;
  --man)             _clia_manuel; exit 0 ;;
  # -v et --version ne sont pas une commande à part : SES-001 tâche 1 pose
  # que la version du CLI est celle du SI. Deux orthographes pour un même
  # objet doivent rendre la même chose, sinon le mot « version » désigne deux
  # choses selon le nombre de tirets qui le précèdent.
  -v|--version)      set -- version ;;
esac

COMMANDE="$1"
shift

# Le nom est comparé à des noms de fichiers : il est restreint pour qu'il ne
# puisse désigner qu'une commande — ni « / », ni « .. ».
if [[ ! "$COMMANDE" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  _clia_msg "nom de commande invalide : $COMMANDE"
  _clia_detail "la liste des commandes : clia --help"
  exit 2
fi

FICHIER=$(_clia_fichier_de "$COMMANDE")
if [[ -z "$FICHIER" ]]; then
  _clia_msg "commande inconnue : $COMMANDE"
  _clia_detail "la liste des commandes : clia --help"
  exit 2
fi

# Une demande de documentation est reconnue ici, à n'importe quelle
# profondeur : « clia version release --help » doit répondre comme « clia
# version --help ». Le chemin retenu est fait des arguments qui précèdent, et
# les options n'en font pas partie — elles nomment une variante d'appel, pas
# un niveau de commande.
CHEMIN="$COMMANDE"
DEMANDE_AIDE=0
DEMANDE_MAN=0
for _arg in "$@"; do
  case "$_arg" in
    -h|--help) DEMANDE_AIDE=1; break ;;
    --man)     DEMANDE_MAN=1;  break ;;
    -*)        ;;
    *)         CHEMIN="$CHEMIN $_arg" ;;
  esac
done

if (( DEMANDE_AIDE )); then
  _clia_aide "$CHEMIN"
  exit 0
fi

# Le périmètre est résolu ici, une fois, plutôt que dans chaque commande :
# une commande nouvelle en hérite sans rien déclarer.
#
# La documentation y échappe : un manuel ne dépend d'aucun dépôt, et exiger
# d'être dans un dépôt git pour lire une page de manuel rendrait inaccessible
# ce que la tâche 3 veut justement accessible partout.
if (( ! DEMANDE_MAN )) && [[ "$(_clia_perimetre_de "$FICHIER")" == 'dépôt' ]]; then
  if ! CLIA_WORK_DIR=$(_clia_depot_git "$PWD"); then
    _clia_msg "le répertoire courant n'est pas dans un dépôt git"
    _clia_detail "clia $COMMANDE agit sur un dépôt ; placez-vous dans l'un d'eux"
    exit 1
  fi

  # La portée d'une installation, quand il y en a une. Une activation vaut
  # pour un seul dépôt de travail — SES-001 tâche 4 — et travailler ailleurs
  # sans s'en apercevoir est précisément ce qu'elle sert à empêcher.
  #
  # Sans installation, aucune portée n'est déclarée et rien ne restreint :
  # c'est le cas quand clia est appelé par son chemin, depuis son dépôt
  # source. La restriction appartient à l'installation, non au CLI.
  if [[ -n "${CLIA_PORTEE:-}" && "$CLIA_WORK_DIR" != "$CLIA_PORTEE" ]]; then
    _clia_msg "hors de la portée de l'installation en cours"
    _clia_detail "portée : $CLIA_PORTEE"
    _clia_detail "ici    : $CLIA_WORK_DIR"
    _clia_detail "pour travailler ici : . setup.sh -C . activate"
    exit 1
  fi

  export CLIA_WORK_DIR
fi

exec bash "$FICHIER" "$@"
